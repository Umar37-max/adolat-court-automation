#
# Environment variables read by the Python scripts (all optional).
# The scripts do NOT load this file automatically: set the variables in your shell
# (PowerShell: $env:ADOLAT_LOGIN = "...") or in the Windows user environment.
# Values in sozlamalar.ini take precedence; these are only used as defaults
# when the key is missing from the ini file (e.g. on first start).
#

# --- ADOLAT (cabinet.sud.uz) -------------------------------------------------
# ONE ID login
ADOLAT_LOGIN=your_one_id_login
# ONE ID password. If set, it is used instead of the DPAPI-encrypted parol.dat
ADOLAT_PAROL=
# TIN (STIR) of the organization profile to select after login
ADOLAT_PROFIL_STIR=your_organization_tin
# Organization name as shown in the "Da'vogar nomi" list
ADOLAT_ASOSIY_DAVOGAR=Your Organization LLC
# Optional co-plaintiff added by TIN (leave empty to skip this step)
ADOLAT_QOSHIMCHA_DAVOGAR_STIR=

# --- Receipt generator (billing.sud.uz) --------------------------------------
KVITANSIYA_TASHKILOT=Your Organization LLC
KVITANSIYA_STIR=payer_tin
KVITANSIYA_MANZIL=Street name 1

# --- Developer / build helpers -----------------------------------------------
# Run Chrome headless during processing (any non-empty value)
ADOLAT_FON=
# Internal UI self-test modes: korinish | dialog | sinov | qadam5 | yuborish
ADOLAT_AVTO_TEST=
# Folder for UI screenshots taken by the self-test (requires Pillow)
ADOLAT_SKRIN=
# Screenshot file path for the receipt generator self-test (requires Pillow)
KV_SKRIN=
# Virtualenv used by exe_yasash.bat (default: %LOCALAPPDATA%\AdolatAvtomat_build)
BUILD_VENV=
